{
  "name": "s3-image-sync-pro",
  "version": "1.7.0",
  "description": "Keep Obsidian image links, a local mirror, and S3/R2 objects consistent with safe directory policies and audits.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node tests/path-sync.test.cjs && node tests/settings-identity.test.cjs && node tests/s3-audit.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "verify-release": "node scripts/validate-release.mjs"
  },
  "keywords": [],
  "author": "hailanbb",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "esbuild": "0.20.0",
    "eslint": "^8.57.1",
    "obsidian": "^1.5.0",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "wasm-feature-detect": "^1.8.0"
  }
}
